{
  "name": "astrovr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AstroVR — My First Moon Mission. NASA Space Apps 2026 (Ganja) · Build a Junior Astronaut Mission Trainer",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build",
    "fetch-data": "node --env-file=.env scripts/fetch-nasa-data.mjs",
    "check-realtime": "node --env-file=.env scripts/check-realtime.mjs",
    "voices": "node --env-file=.env scripts/generate-voices.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
