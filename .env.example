# Copy to .env.local and fill in. In Vercel, add the same keys as Environment Variables.
# NASA Open APIs key (https://api.nasa.gov). DEMO_KEY allows only ~10 requests/hour.
VITE_NASA_API_KEY=DEMO_KEY

# Supabase project (Realtime Broadcast, no tables needed). Use the PUBLIC anon/publishable key only.
# Leave empty to use the local BroadcastChannel transport (two tabs in one browser) for development.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
